"DepotBuildConfig"
{
  "DepotID" "YOUR_DEPOT_ID"
  "ContentRoot" "C:/path/to/delivery-sim/steam/depot"
  "FileMapping"
  {
    "LocalPath" "*"
    "DepotPath" "."
    "recursive" "1"
  }
  "FileExclusion" "steam_appid.txt"
  "FileExclusion" "steam_appid.txt.example"
  "FileExclusion" "*.pdb"
  "FileExclusion" "**/*.log"
}
